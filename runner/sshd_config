# sshd runs unprivileged, as the only user it can authenticate. Keys only.
Port 2222
ListenAddress 0.0.0.0
HostKey /tmp/sshd/ssh_host_ed25519_key
PidFile /tmp/sshd/sshd.pid
# StrictModes checks every directory on the way, so this cannot live under
# /tmp; the entrypoint makes $HOME and ~/.ssh private.
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers node

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
UsePAM no

# Runs exec commands only: no forwarding of any kind, no TTY.
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no
PermitTTY no
PermitUserEnvironment no

# Agent runs can be long and quiet.
ClientAliveInterval 60
ClientAliveCountMax 10

LogLevel INFO
