{
  "name": "@ryanjdillon/paperclip-sandbox-ssh",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Paperclip sandbox provider that runs on an existing SSH server",
  "license": "MIT",
  "author": "ryanjdillon",
  "repository": "github:ryanjdillon/paperclip-image",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": ["paperclip", "plugin", "sandbox", "ssh"],
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1117.0",
    "@paperclipai/shared": "2026.1117.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
